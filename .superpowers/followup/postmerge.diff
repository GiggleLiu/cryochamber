 .topbar {
-  display: flex; align-items: center; gap: 0.5rem;
-  padding: 0.75rem 1rem; padding-top: calc(0.75rem + env(safe-area-inset-top));
-  background: #4f46e5; color: #fff; position: sticky; top: 0;
