+/* ==========================================================================
+   Agent Console — design tokens
+
+   Palette is the WeChat family (the conversation is the product, so the
+   message canvas and the self-bubble green are fixed points) narrowed to an
+   "agent console" register: green is reserved for actions and the user's own
+   voice, everything else is neutral so agent output reads as the content.
+
+   Type pairs the platform UI face with a monospace utility face. The mono is
+   not decoration: it marks everything the machine produced or measured —
+   timestamps, counts, code, the version string — which is exactly the
+   distinction this product is about.
+   ========================================================================== */
+:root {
+  color-scheme: light;
+
+  /* Color ---------------------------------------------------------------- */
+  --brand: #07c160;          /* WeChat action green */
+  --brand-press: #06a552;
+  --brand-tint: #e7f8ee;
+  --bubble-self: #95ec69;
+  --bubble-self-press: #86dc5c;
+
+  --canvas: #ededed;         /* conversation ground */
+  --surface: #ffffff;
+  --surface-2: #f5f5f6;      /* app ground behind grouped lists */
+  --surface-press: #ebebec;
+  --code-bg: #f4f5f6;
+  --skeleton-a: #e8e9ea;     /* placeholder shimmer, on white surfaces */
+  --skeleton-b: #f1f2f3;
+
+  --ink: #16171a;            /* 15.9:1 on white */
+  --ink-2: #43474d;          /* 8.9:1 on white */
+  --ink-3: #5f646a;          /* 4.8:1 on white, 4.7:1 on canvas */
+  --on-brand: #ffffff;
+
+  --line: #e3e4e6;
+  --line-strong: #d2d4d7;
+
+  --link: #576b95;           /* WeChat link blue */
+  --danger: #d92d20;
+  --danger-tint: #fdecea;
+  --warn: #9a5b00;
+  --warn-tint: #fdf3e3;
+
+  /* Type ----------------------------------------------------------------- */
+  --font-ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
+    "Helvetica Neue", Arial, sans-serif;
+  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
+    "Liberation Mono", monospace;
+
+  --fs-2xs: 0.6875rem;  /* 11 — badges, meta, separators */
+  --fs-xs: 0.75rem;     /* 12 — sender labels, captions */
+  --fs-sm: 0.8125rem;   /* 13 — secondary rows, code */
+  --fs-md: 0.9375rem;   /* 15 — list titles, controls */
+  --fs-base: 1.0625rem; /* 17 — message text */
+  --fs-lg: 1.0625rem;   /* 17 — bar titles */
+  --fs-xl: 1.75rem;     /* 28 — wordmark */
+
+  --lh-tight: 1.25;
+  --lh: 1.45;
+  --lh-loose: 1.55;
+
+  /* Space — 4px rhythm --------------------------------------------------- */
+  --sp-1: 0.25rem;
+  --sp-2: 0.5rem;
+  --sp-3: 0.75rem;
+  --sp-4: 1rem;
+  --sp-5: 1.25rem;
+  --sp-6: 1.5rem;
+  --sp-8: 2rem;
+  --sp-10: 2.5rem;
+
+  /* Radius --------------------------------------------------------------- */
+  --r-xs: 4px;
+  --r-sm: 8px;
+  --r-md: 12px;
+  --r-lg: 16px;
+  --r-xl: 22px;
+  --r-full: 999px;
+
+  /* Elevation ------------------------------------------------------------ */
+  --shadow-1: 0 1px 2px rgba(16, 24, 40, 0.06);
+  --shadow-2: 0 6px 20px rgba(16, 24, 40, 0.10), 0 1px 3px rgba(16, 24, 40, 0.06);
+  --shadow-3: 0 -4px 28px rgba(16, 24, 40, 0.14);
+
